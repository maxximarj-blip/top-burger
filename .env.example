# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). A chave "anon"/"publishable" é pública por natureza:
# quem protege os dados são as regras RLS do banco.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
